# dme_access_time.py configuration
#
# Copy this file to ".dme_access_time.env", fill in the values (especially the
# secrets), and lock it down:
#
#   cp dme_access_time.env.example .dme_access_time.env
#   chmod 600 .dme_access_time.env
#
# The real ".dme_access_time.env" is git-ignored and must NEVER be committed.
# All values below map 1:1 to a CLI flag; a CLI flag always overrides the env var.

# --- Trino connection ---
export DME_TRINO_HOST="ncivs-t001-trino-lab.nci.nih.gov"
export DME_TRINO_PORT="8443"
export DME_TRINO_USER="rosenbergea"
# Trino password. If left empty/unset, the script prompts securely at runtime.
export DME_TRINO_PASSWORD=""

# --- Query scope ---
export DME_SINCE="6m"
export DME_VIEW_PATH="/CBIIT/DMAP/DME_test_DataStage2/AUTO-TIERING-DEV"

# --- S3 target ---
export DME_S3_BUCKET="dmelab"
export DME_OBJECT_ID="AUTO-TIERING-DEV"
export DME_S3_ENDPOINT="https://main.sg-ncivs-t001.nci.nih.gov"
export DME_S3_ACCESS_KEY="CHANGE_ME"
export DME_S3_SECRET_KEY="CHANGE_ME"

# --- Optional flags (set to "true" to enable) ---
# Skip SSL certificate verification for Trino and S3 (dev/test only).
export DME_INSECURE="true"
# Do not modify tags; just log actions.
export DME_DRY_RUN="false"
# Print full stack trace on errors.
export DME_STACKTRACE="false"
